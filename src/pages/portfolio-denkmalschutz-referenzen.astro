---
import Layout from '../layouts/Layout.astro';
import Container from '../components/Container.astro';
import { Image } from 'astro:assets';

// Import Images
import marienburgMain from '../assets/images/denkmalschutz/marienburg-main.webp';
import marienburgPlan1 from '../assets/images/denkmalschutz/marienburg-plan-1.webp';
import marienburgPlan2 from '../assets/images/denkmalschutz/marienburg-plan-2.webp';
import marienburgPlan3 from '../assets/images/denkmalschutz/marienburg-plan-3.webp';

import stgangolfMain from '../assets/images/denkmalschutz/stgangolf-main.webp';
import stgangolfPlan1 from '../assets/images/denkmalschutz/stgangolf-plan-1.webp';
import stgangolfPlan2 from '../assets/images/denkmalschutz/stgangolf-plan-2.webp';

import geburtshausMain from '../assets/images/denkmalschutz/geburtshaus-main.webp';
import geburtshausPlan1 from '../assets/images/denkmalschutz/geburtshaus-plan-1.webp';
import geburtshausPlan2 from '../assets/images/denkmalschutz/geburtshaus-plan-2.webp';

// Projects data
const projects = [
    {
        title: "Marienburg",
        address: "Marienburg 1, 56856 Zell (Mosel)",
        year: "2017 - 2018",
        attribution: "im Rahmen meiner Anstellung bei BERDI Planung GmbH",
        mainPhoto: marienburgMain,
        description: "Denkmalgerechte Sanierung der ehemaligen kurfürstlichen Residenz und Klosteranlage. Die Marienburg, weithin sichtbar auf dem Zeller Hamm gelegen, erforderte eine hochsensible Herangehensweise, um die historische Bausubstanz mit moderner Nutzung als Bildungsstätte in Einklang zu bringen. Gemäß strengen denkmalrechtlichen Auflagen wurde die Fassade und die innere Struktur unter Erhalt originaler Details wiederhergestellt.",
        services: [
            "TLS-Laserscanning, ergänzende Handaufmaße",
            "Einarbeiten der Geovermessung (TLS)",
            "Erstellung aller Bestandspläne",
            "Erstellung des gesamten BIM-Modells"
        ],
        specMethod: "TLS-Laserscanning, ergänzende Handaufmaße",
        specLOD: "Verformungsgerecht Stufe II / BIM LoD 300",
        heritageLink: "https://www.kuladig.de/Objektansicht/KLD-244684",
        plans: [
            { src: marienburgPlan1, type: "Grundriss" },
            { src: marienburgPlan2, type: "Schnitt" },
            { src: marienburgPlan3, type: "Ansicht" }
        ]
    },
    {
        title: "Marktkirche St. Gangolf",
        address: "Hauptmarkt 9, 54290 Trier",
        year: "2018",
        attribution: "im Rahmen meiner Anstellung bei BERDI Planung GmbH",
        mainPhoto: stgangolfMain,
        description: "Die älteste Marktkirche Deutschlands ist ein zentrales Monument der Trierer Stadtgeschichte. Das Projekt umfasste die detaillierte Bauaufnahme zur Vorbereitung von Instandsetzungsmaßnahmen am Turm und im Langhaus. Ein besonderes Augenmerk lag auf der Dokumentation der gotischen Gewölbestrukturen. BERDI Planung GmbH unterstreicht hierbei die Bedeutung der digitalen Erhaltung: 'Nur eine lückenlose Dokumentation ermöglicht den Erhalt für kommende Generationen.'",
        services: [
            "TLS-Laserscanning, ergänzende Handaufmaße",
            "Erstellung aller Bestandspläne",
            "Detailliertes Handaufmaß des Dachstuhls",
            "Vollständiges Außenaufmaß"
        ],
        specMethod: "TLS-Laserscanning, ergänzende Handaufmaße",
        specLOD: "Verformungsgerechtes Aufmaß Stufe II",
        heritageLink: "https://kulturdb.de/einobjekt.php?id=87",
        plans: [
            { src: stgangolfPlan1, type: "Grundriss" },
            { src: stgangolfPlan2, type: "Schnitt" }
        ]
    },
    {
        title: "Cusanus Geburtshaus",
        address: "Nikolausufer 49, 54470 Bernkastel-Kues",
        year: "2019",
        attribution: "im Rahmen meiner Anstellung bei BERDI Planung GmbH",
        mainPhoto: geburtshausMain,
        description: "Das Geburtshaus des berühmten Gelehrten Nikolaus von Kues ist ein herausragendes Beispiel spätmittelalterlicher Architektur an der Mosel. Die Sanierungsmaßnahmen wurden mit höchster Sorgfalt durchgeführt, um den originalen Charakter des Gebäudes als Museum und Forschungsstätte zu bewahren. Sämtliche Arbeiten wurden in enger Abstimmung mit dem Denkmalschutz gemäß den strengen rechtlichen Vorgaben zur Wiederherstellung historischer Ensembles realisiert.",
        services: [
            "Erstellung aller Bestandspläne auf Basis vorl. Aufmaße",
            "Präzise zeichnerische Rekonstruktion",
            "Dokumentation nach denkmalrechtlichen Vorgaben",
            "Zusammenführung historischer Bestandsdaten"
        ],
        specMethod: "Planerstellung auf Basis externer Aufmaße",
        specLOD: "Verformungsgerechtes Aufmaß Stufe II",
        heritageLink: "https://kulturdb.de/einobjekt.php?id=189",
        plans: [
            { src: geburtshausPlan2, type: "Grundriss" },
            { src: geburtshausPlan1, type: "Ansicht" }
        ]
    }
];
---

<Layout title="Expertise & Referenzen Denkmalschutz | studio-os.de">
    <main class="snap-y snap-proximity h-screen overflow-y-auto bg-transparent scroll-smooth">
        
        <!-- Intro Section -->
        <section class="min-h-dvh flex flex-col justify-center snap-start relative py-20 border-b border-white/5">
            <Container class="relative z-10 max-w-5xl">
                <span class="text-matcha font-bold uppercase tracking-[0.3em] text-sm mb-6 block">Expertise & Erfahrung</span>
                <h1 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white font-heading leading-tight mb-10">
                    Über 10 Jahre <br/> <span class="text-matcha">Vermessung & Dokumentation</span>
                </h1>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-lg leading-relaxed text-gray-700 dark:text-gray-300">
                    <div class="space-y-6">
                        <p>
                            Seit über einer Dekade konzentriere ich mich fast ausschließlich auf die präzise Vermessung und denkmalgerechte Bestandsdokumentation. Diese tiefgreifende Erfahrung sammelte ich insbesondere während meiner langjährigen Tätigkeit bei der 
                            <a href="https://www.berdi-architekten.de/" target="_blank" rel="noopener noreferrer" class="text-matcha hover:text-almond underline underline-offset-4 decoration-matcha/30 font-bold transition-colors">BERDI Planung GmbH</a>. 
                        </p>
                        <p>
                            Dort lag mein Fokus auf hochkomplexen Projekten, für die ich verformungsgerechte Aufmaße und detaillierte Schadenskartierungen erstellte. Referenzen zu meiner dortigen Arbeit können Sie gerne direkt bei Simon oder Jan Berdi unter den untenstehenden Kontaktdaten nachhören.
                        </p>
                    </div>
                    <div class="space-y-6 border-l border-matcha/20 pl-8">
                        <p>
                            In den letzten 5 Jahren – insbesondere während meiner Anstellung bei <a href="https://www.brittatibo.de/" target="_blank" rel="noopener noreferrer" class="text-matcha hover:text-almond underline underline-offset-4 decoration-matcha/30 font-bold transition-colors">tibo ^ architektur</a> – habe ich mich intensiv auf die Erfassung mittels hochpräziser <strong>Punktwolken (TLS)</strong> spezialisiert.
                        </p>
                        <p>
                            Dabei stand die Aufbereitung komplizierter geometrischer Herausforderungen für die weitere Planung in 2D und 3D im Mittelpunkt. Diese geballte Erfahrung an der Schnittstelle zwischen Realität und digitalem Modell bündele ich heute in meinem eigenen Studio für 3D-Vermessung.
                        </p>
                    </div>
                </div>

                <!-- Expertise / Skills List -->
                <div class="mt-12 pt-12 border-t border-white/5">
                    <h3 class="text-sm font-bold text-gray-900 dark:text-white font-heading mb-8 uppercase tracking-[0.2em] flex items-center gap-3">
                        Erworbene Kernkompetenzen
                        <span class="flex-1 h-[1px] bg-black/10 dark:bg-white/10"></span>
                    </h3>
                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-6">
                        {[
                            "TLS-Laserscanning",
                            "Punktwolken-Auswertung",
                            "Verformungsgerechtes Aufmaß",
                            "BIM-Modellierung",
                            "Schadenskartierung"
                        ].map(skill => (
                            <div class="flex items-center gap-3 text-sm font-medium text-gray-700 dark:text-gray-300 bg-black/5 dark:bg-white/5 p-3 rounded-lg border border-white/5">
                                <span class="text-matcha font-bold">▹</span>
                                {skill}
                            </div>
                        ))}
                    </div>
                </div>

                <!-- Referenz-Kontaktboxen -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
                    <!-- BERDI Box -->
                    <div class="p-6 bg-black/5 dark:bg-white/5 rounded-2xl border border-matcha/10 flex flex-col justify-between hover:border-matcha/30 transition-all">
                        <div>
                            <span class="text-[10px] uppercase text-matcha tracking-[0.2em] font-bold block mb-4">Referenzkontakt BERDI</span>
                            <a href="https://www.berdi-architekten.de/" target="_blank" rel="noopener noreferrer" class="text-xl font-bold text-gray-900 dark:text-white hover:text-matcha transition-colors underline underline-offset-4 decoration-matcha/30 block mb-1">berdi-architekten.de</a>
                            <div class="text-gray-600 dark:text-gray-400 mb-4 text-sm leading-relaxed">
                                <p class="font-bold text-gray-900 dark:text-white">Simon Berdi & Jan Berdi</p>
                                <p>Friedrichstraße 8, 54470 Bernkastel-Kues</p>
                            </div>
                        </div>
                        <a href="tel:+496531501780" class="text-lg font-bold text-matcha hover:text-almond transition-colors flex items-center gap-2">
                             <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                             +49 6531 50178-0
                        </a>
                    </div>

                    <!-- Tibo Box -->
                    <div class="p-6 bg-black/5 dark:bg-white/5 rounded-2xl border border-matcha/10 flex flex-col justify-between hover:border-matcha/30 transition-all">
                        <div>
                            <span class="text-[10px] uppercase text-matcha tracking-[0.2em] font-bold block mb-4">Referenzkontakt Tibo</span>
                            <a href="https://www.brittatibo.de/" target="_blank" rel="noopener noreferrer" class="text-xl font-bold text-gray-900 dark:text-white hover:text-matcha transition-colors underline underline-offset-4 decoration-matcha/30 block mb-1">brittatibo.de</a>
                            <div class="text-gray-600 dark:text-gray-400 mb-4 text-sm leading-relaxed">
                                <p class="font-bold text-gray-900 dark:text-white">Britta Tibo AKRP</p>
                                <p>Am Wissenschaftspark 9, D – 54296 Trier</p>
                            </div>
                        </div>
                        <a href="tel:+4965199791990" class="text-lg font-bold text-matcha hover:text-almond transition-colors flex items-center gap-2">
                             <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                             +49 (0)651 9979199 0
                        </a>
                    </div>
                </div>

                <div class="mt-16 flex items-center gap-4 text-sm uppercase tracking-widest text-gray-500">
                    <span class="w-12 h-[1px] bg-matcha"></span>
                    Scrollen für Referenzprojekte
                </div>
            </Container>

            <!-- Background Decoration -->
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full pointer-events-none overflow-hidden z-0 opacity-[0.2]">
                 <div class="absolute -top-1/4 -left-1/4 w-[700px] h-[700px] bg-matcha/10 blur-[150px] rounded-full animate-pulse"></div>
                 <div class="absolute -bottom-1/4 -right-1/4 w-[700px] h-[700px] bg-forest/10 blur-[150px] rounded-full animate-pulse" style="animation-delay: 2s;"></div>
            </div>
        </section>

        {projects.map((project, index) => (
            <section class={`min-h-dvh flex flex-col justify-center snap-start relative py-12 md:py-16 border-b border-white/5`}>
                <Container class="flex flex-col relative z-10 max-w-[1400px]">
                    <!-- 1. Kopfbereich (Header) -->
                    <div class="flex flex-col md:flex-row justify-between items-end gap-6 border-b border-white/10 pb-4 mb-6">
                        <div>
                            <span class="text-matcha font-bold uppercase tracking-[0.3em] text-xs mb-2 block">Referenzprojekt {index + 1}</span>
                            <h2 class="text-4xl md:text-6xl font-bold text-gray-900 dark:text-white font-heading leading-tight">
                                {project.title}
                            </h2>
                            <p class="text-xl md:text-2xl text-almond/90 font-medium mt-1">{project.address} | {project.year}</p>
                        </div>
                        <div class="text-right hidden md:block">
                            <p class="text-base md:text-lg text-gray-400 whitespace-nowrap italic font-medium">
                                {project.attribution}
                            </p>
                        </div>
                    </div>

                    <!-- 2. Hauptbereich (Zweispaltig) -->
                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-stretch mb-8 min-h-0">
                        <!-- Linke Spalte (60%) -->
                        <div class="lg:col-span-7 relative flex flex-col">
                            <div class="relative overflow-hidden rounded-2xl shadow-2xl flex-1 min-h-[300px]">
                                <Image 
                                    src={project.mainPhoto} 
                                    alt={project.title} 
                                    class="w-full h-full object-cover"
                                    width={1200}
                                    height={800}
                                />
                                
                                <!-- Heritage Badge (Link to Denkmalschutz Source) -->
                                <a 
                                    href={project.heritageLink} 
                                    target="_blank" 
                                    rel="noopener noreferrer"
                                    class="absolute top-6 left-6 bg-eclipse/90 backdrop-blur-xl border border-white/20 px-4 py-2 rounded-full text-xs font-bold text-white uppercase tracking-widest hover:bg-matcha transition-all shadow-2xl flex items-center gap-3 group/badge"
                                >
                                    <svg class="w-4 h-4 text-almond group-hover/badge:text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M10 2a8 8 0 100 16 8 8 0 000-16zM9 13V7l5 3-5 3z"/></svg>
                                    Nachweis Denkmalschutz
                                </a>
                            </div>
                        </div>

                        <!-- Rechte Spalte (40%) -->
                        <div class="lg:col-span-5 flex flex-col justify-between space-y-6 py-2">
                            <section>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white font-heading mb-3 uppercase tracking-wider flex items-center gap-4">
                                    <span class="w-10 h-[2px] bg-matcha"></span> Zum Projekt
                                </h3>
                                <p class="text-gray-700 dark:text-gray-300 text-sm md:text-lg leading-relaxed mb-6">
                                    {project.description}
                                </p>
                                
                                <!-- Official Information Link -->
                                <div class="mt-6 flex flex-col gap-3 p-4 bg-black/5 dark:bg-white/5 rounded-xl border border-black/5 dark:border-white/5">
                                    <span class="text-[10px] uppercase text-gray-500 dark:text-gray-400 tracking-[0.2em] font-bold flex items-center gap-2">
                                        <span class="w-2 h-2 rounded-full bg-matcha animate-pulse"></span> Denkmalschutz:
                                    </span>
                                    <a 
                                        href={project.heritageLink} 
                                        target="_blank" 
                                        rel="noopener noreferrer"
                                        class="text-matcha hover:text-almond text-sm md:text-base font-bold flex items-center gap-3 transition-all group"
                                    >
                                        <span class="border-b-2 border-matcha/30 pb-0.5 group-hover:border-almond/50 transition-all">Informationen zu {project.title}</span>
                                        <svg class="w-5 h-5 transform group-hover:translate-x-2 transition-transform text-almond" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                        </svg>
                                    </a>
                                </div>
                            </section>

                            <section>
                                <h3 class="text-xl font-bold text-gray-900 dark:text-white font-heading mb-3 uppercase tracking-wider flex items-center gap-4">
                                    <span class="w-10 h-[2px] bg-matcha"></span> Leistungsumfang
                                </h3>
                                <ul class="grid grid-cols-1 gap-y-3">
                                    {project.services.map(service => (
                                        <li class="flex items-start gap-4 leading-snug text-gray-700 dark:text-gray-300">
                                            <span class="text-matcha shrink-0 text-xl font-bold leading-none mt-1">▹</span>
                                            <span class="text-sm md:text-lg lg:text-xl font-medium">{service}</span>
                                        </li>
                                    ))}
                                </ul>
                            </section>

                            <section class="pt-4">
                                <div class="grid grid-cols-2 gap-4">
                                    <div class="p-4 bg-black/5 dark:bg-white/5 rounded-xl border border-black/10 dark:border-white/10 hover:border-matcha/50 transition-all group/spec">
                                        <span class="block text-[10px] uppercase text-gray-500 mb-2 tracking-widest font-bold">Vermessungsmethode</span>
                                        <span class="font-bold text-almond group-hover/spec:text-gray-900 dark:group-hover/spec:text-white transition-colors text-xs md:text-sm leading-tight block">{project.specMethod}</span>
                                    </div>
                                    <div class="p-4 bg-black/5 dark:bg-white/5 rounded-xl border border-black/10 dark:border-white/10 hover:border-matcha/50 transition-all group/spec">
                                        <span class="block text-[10px] uppercase text-gray-500 mb-2 tracking-widest font-bold">Detaillierungsgrad</span>
                                        <span class="font-bold text-almond group-hover/spec:text-gray-900 dark:group-hover/spec:text-white transition-colors text-xs md:text-sm leading-tight block">{project.specLOD}</span>
                                    </div>
                                </div>
                            </section>
                        </div>
                    </div>

                    <!-- 3. Unterer Bereich (Galerie) -->
                    <div class="mt-4">
                        <h3 class="text-sm font-bold text-gray-900 dark:text-white font-heading mb-4 uppercase tracking-[0.2em] flex items-center gap-3">
                             Beispiel Planzeichnungen
                             <span class="flex-1 h-[1px] bg-black/10 dark:bg-white/10"></span>
                        </h3>
                        <div class="bg-eclipse/10 dark:bg-eclipse/40 backdrop-blur-xl p-6 rounded-2xl border border-black/5 dark:border-white/5 shadow-inner">
                            <div class="flex flex-row gap-6 h-32 md:h-56 lg:h-72 text-gray-900 dark:text-white">
                                {project.plans.map((plan, pIdx) => (
                                    <div class="flex-1 cursor-pointer lightbox-trigger group relative overflow-hidden rounded-xl border border-black/5 dark:border-white/5 transition-all duration-500" data-src={plan.src.src}>
                                        <Image 
                                            src={plan.src} 
                                            alt={`Beispiel ${plan.type}`} 
                                            class="w-full h-full object-cover transition-all duration-700 brightness-[0.95] dark:brightness-[0.85] group-hover:brightness-110 group-hover:contrast-110"
                                            style="object-position: 0 100%;"
                                            width={600}
                                            height={450}
                                        />
                                        <div class="absolute inset-0 bg-black/30 group-hover:bg-matcha/10 transition-all group-hover:shadow-[inset_0_0_50px_rgba(103,124,105,0.2)]"></div>
                                        
                                        <!-- Bottom Left Indicator Label (Permanent) -->
                                        <div class="absolute bottom-3 left-3 bg-white/80 dark:bg-black/60 backdrop-blur-md px-3 py-1 rounded text-[10px] text-gray-900 dark:text-white/90 uppercase tracking-widest border border-black/5 dark:border-white/10 z-10 group-hover:bg-matcha/80 group-hover:text-white group-hover:border-matcha transition-colors">
                                            {plan.type}
                                        </div>

                                        <!-- Zoom Icon (Bottom Right on Hover) -->
                                        <div class="absolute bottom-3 right-3 bg-matcha p-2.5 rounded-full transform translate-y-12 opacity-0 group-hover:translate-y-0 group-hover:opacity-100 transition-all duration-500 shadow-xl z-20">
                                            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                                                <circle cx="11" cy="11" r="8"></circle>
                                                <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                                                <line x1="11" y1="8" x2="11" y2="14"></line>
                                                <line x1="8" y1="11" x2="14" y2="11"></line>
                                            </svg>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>
                </Container>
                
                <!-- Background Decoration -->
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full pointer-events-none overflow-hidden z-0 opacity-[0.15]">
                     <div class="absolute top-1/4 -right-1/4 w-[600px] h-[600px] bg-matcha/20 blur-[150px] rounded-full"></div>
                     <div class="absolute bottom-1/4 -left-1/4 w-[600px] h-[600px] bg-forest/20 blur-[150px] rounded-full"></div>
                </div>
            </section>
        ))}

        <!-- Mobile Info Footer -->
        <div class="md:hidden p-12 bg-eclipse text-center snap-start min-h-[200px] flex items-center justify-center">
            <p class="text-gray-500 text-xs uppercase tracking-[0.3em] leading-loose">
                Realisiert im Rahmen der <br/> Anstellung bei <br/> 
                <span class="text-almond font-bold text-lg">BERDI Planung GmbH</span>
            </p>
        </div>

        <!-- Lightbox -->
        <div id="lightbox" class="fixed inset-0 z-[200] bg-black/98 flex items-center justify-center opacity-0 pointer-events-none transition-all duration-500 backdrop-blur-[30px]">
            <button id="lightbox-close" class="absolute top-8 right-8 text-white p-5 hover:text-matcha transition-all z-[210] bg-white/5 rounded-full hover:rotate-90" aria-label="Schließen">
                <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
            <div class="w-full h-full p-4 md:p-16 flex items-center justify-center">
                <img id="lightbox-img" src="" alt="Vergrößerte Detailansicht" class="max-w-full max-h-full object-contain shadow-[0_0_80px_rgba(0,0,0,0.8)] rounded-md border border-white/10" />
            </div>
        </div>
    </main>
</Layout>

<style>
    :global(html, body) {
        height: 100%;
        overflow: hidden;
        background-color: transparent;
    }

    main {
        scrollbar-width: thin;
        scrollbar-color: #1A3636 transparent;
    }

    main::-webkit-scrollbar {
        width: 4px;
    }
    main::-webkit-scrollbar-track {
        background: transparent;
    }
    main::-webkit-scrollbar-thumb {
        background: #1A3636;
        border-radius: 10px;
    }

    #lightbox.active {
        opacity: 1;
        pointer-events: auto;
    }

    @media (max-width: 1024px) {
        :global(html, body) {
            overflow: auto;
            height: auto;
        }
        main {
            height: auto;
            overflow: visible;
            scroll-snap-type: none;
        }
        section {
            min-height: auto;
            snap-align: none;
            padding-bottom: 4rem;
        }
    }
    
    @media (min-width: 1025px) {
        section {
            scroll-snap-stop: always;
        }
    }
</style>

<script>
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxClose = document.getElementById('lightbox-close');
    const triggers = document.querySelectorAll('.lightbox-trigger');

    triggers.forEach(trigger => {
        trigger.addEventListener('click', () => {
            const fullSrc = trigger.getAttribute('data-src');
            if (fullSrc && lightbox && lightboxImg) {
                lightboxImg.src = fullSrc;
                lightbox.classList.add('active');
            }
        });
    });

    const closeLightbox = () => {
        if (lightbox) {
            lightbox.classList.remove('active');
        }
    };

    lightboxClose?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
        if (e.target === lightbox) {
            closeLightbox();
        }
    });

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeLightbox();
        }
    });
</script>
