---
import Container from '../components/Container.astro';
import Layout from '../layouts/Layout.astro';
import SoftwareCarousel from '../components/SoftwareCarousel.astro';
import { Image } from 'astro:assets';

import osLogoLight from '../assets/OS LOGO light.svg';
import osLogoDark from '../assets/OS LOGO dark.svg';

import bimImage from '../assets/images/bim/bim-daten-architektur-3d-modell-visualisierung.webp';

import pinterestLight from '../assets/images/logos/pinterest light.svg';
import pinterestDark from '../assets/images/logos/pinterest dark.svg';
import instagramLight from '../assets/images/logos/instagram light.svg';
import instagramDark from '../assets/images/logos/instagram dark.svg';
import linkedinLight from '../assets/images/logos/linkedin light.svg';
import linkedinDark from '../assets/images/logos/linkedin dark.svg';

const vermessungImages = import.meta.glob('../assets/images/vermessung/**/*.webp', { eager: true });
const rendersImages = import.meta.glob('../assets/images/renders/*.webp', { eager: true });
const homestagingImages = import.meta.glob('../assets/images/homestaging/*.webp', { eager: true });

const vermessungProjectsMap: Record<string, any> = {};

for (const path in vermessungImages) {
    const parts = path.split('/');
    const folderName = parts[parts.length - 2];
    const fileName = parts[parts.length - 1];

    if (!folderName.includes('_') || fileName.startsWith('.')) continue;

    const [numStr, ...nameParts] = folderName.split('_');
    const num = parseInt(numStr);
    const projectName = nameParts.join('_');

    if (!vermessungProjectsMap[folderName]) {
        vermessungProjectsMap[folderName] = {
            num,
            title: projectName,
            images: []
        };
    }
    vermessungProjectsMap[folderName].images.push({
        path: (vermessungImages[path] as any).default,
        name: fileName,
        width: (vermessungImages[path] as any).default.width,
        height: (vermessungImages[path] as any).default.height
    });
}

const projects = Object.values(vermessungProjectsMap)
    .sort((a : any, b : any) => a.num - b.num)
    .map((p : any) => ({
        title: p.title,
        description: "Klicken zum Anzeigen der Slideshow.",
        images: p.images.sort((a : any, b : any) => a.name.localeCompare(b.name)).map((img : any) => ({
            src: img.path,
            isWide: (img.width / img.height) > 1.5
        }))
    }));

projects.push({
    title: "Ihr nächstes Projekt",
    description: "Klicken zum Anzeigen der Slideshow.",
    images: [
        { src: bimImage, isWide: (bimImage.width / bimImage.height) > 1.5 },
    ]
});

const processSimpleImages = (glob: Record<string, any>) => {
    return Object.keys(glob)
        .sort()
        .map((path) => {
            const img = (glob[path] as any).default;
            return {
                src: img,
                isWide: (img.width / img.height) > 1.5
            };
        });
};

const visualizations = [
    {
        title: "Professionelle Visualisierungen",
        description: "Ob basierend auf 2D-Plänen oder fertigen 3D-Modellen: Wir verwandeln Ihre Visionen in fotorealistische Renderings, stilisierte Montagen oder dynamische Videos.",
        images: processSimpleImages(rendersImages)
    },
    {
        title: "Digitales Home-Staging",
        description: "Wir zeigen das volle Potenzial unmöblierter Räume, indem wir sie virtuell einrichten – so werden Immobilien für Käufer sofort emotional erlebbar.",
        images: processSimpleImages(homestagingImages)
    }
];
---

<Layout 
	title="studio-os.de | Präzise Vermessung, CAD-Planung & BIM-Modellierung"
	description="Experte für Gebäudevermessung, digitales Aufmaß und BIM-konforme 3D-Modelle. Wir bieten zentimetergenaue Bestandserfassung, CAD-Konstruktion und fotorealistische Visualisierung."
	keywords="Vermessung, Digitales Aufmaß, Bestandsaufnahme, Zentimetergenaue Bestandserfassung, Bestandspläne, Planzeichnung, 2D/3D Bestandsdokumentation, Grundrisse, Schnitte, Ansichten, CAD-Planung, Bauplanung, Computer-Aided Design, Bauzeichnung, CAD-Konstruktion, BIM, Building Information Modeling, BIM-Modellierung, Industry Foundation Classes, IFC, BIM-Konformität, Visualisierung, 3D-Design, 3D-Architekturvisualisierung, Rendering, Digital Twins, Räumliche Darstellung"
>
	<main class="overflow-x-hidden">
		<!-- Hero Section -->
		<div class="relative min-h-dvh flex flex-col transition-all duration-700 ease-in-out snap-start" id="home">
			<div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-50 dark:opacity-30">
				<div class="blur-[106px] h-64 bg-gradient-to-br from-matcha to-forest hidden dark:block dark:from-matcha/40"></div>
				<div class="blur-[106px] h-40 bg-gradient-to-r from-almond to-matcha hidden dark:block dark:to-forest/50"></div>
			</div>
			<Container class="flex-[8.5] flex flex-col pt-24 md:pt-32 pb-8 md:pb-12">
				<div class="relative flex flex-col lg:flex-row items-start lg:items-center justify-center lg:justify-between gap-12 lg:gap-24 transition-all duration-700 zoom-content flex-1 w-full" id="hero-content">
                    <!-- Background Animation & Bokeh -->
                    <div class="absolute inset-0 pointer-events-none z-0">
                        <!-- Bokeh Effect -->
                        <div class="absolute top-1/2 left-[70%] -translate-x-1/2 -translate-y-1/2 blur-[120px] bg-matcha/20 rounded-full scale-[2] w-64 h-64 lg:w-96 lg:h-96"></div>
                        
                        <!-- WebM Animation -->
                        <div class="absolute inset-0 flex items-center">
                            <div class="absolute left-[80%] -translate-x-1/2 w-[300px] h-[300px] flex items-center justify-center">
                                <video 
                                    id="hero-video-light-bg"
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    class="w-full h-full object-contain scale-[2.0] opacity-10 dark:hidden"
                                >
                                    <source src={`${import.meta.env.BASE_URL}animation/animation light.webm`} type="video/webm" />
                                </video>
                                <video 
                                    id="hero-video-dark-bg"
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    class="w-full h-full object-contain scale-[2.0] opacity-10 hidden dark:block"
                                >
                                    <source src={`${import.meta.env.BASE_URL}animation/animation dark.webm`} type="video/webm" />
                                </video>
                            </div>
                        </div>
                    </div>

					<div class="w-full lg:w-[45%] text-left reveal z-10 flex flex-col justify-center h-full">
						<h1 class="text-gray-900 dark:text-white font-bold text-3xl md:text-4xl xl:text-5xl font-heading leading-tight transition-all duration-700" id="hero-title" aria-label="Präzise Vermessung und 3D-Planung für Ihre Projekte">
							Präzise Vermessung <br/> & 3D-Planung für <br/> Ihre Projekte
						</h1>
						<p class="mt-8 text-gray-700 dark:text-gray-300 text-base lg:text-lg max-w-xl transition-all duration-700" id="hero-text">
							Unser Ziel ist Ihr reibungsloser Workflow für sämtliche CAD- und 3D-Projekte. Basierend auf BIM-Methodik erstellen wir alles vom 2D-Bestandsplan bis zum 3D-Modell.<br><br>Vergessen Sie dabei das lästige Konvertieren von Fremddateien: Auf Wunsch erhalten Sie alle Projektdaten visuell konsistent und direkt im nativen Format Ihrer Software – einfach öffnen und weiterarbeiten!						</p>
						<div class="mt-12 flex flex-wrap gap-y-4 gap-x-6">
							<a
							  href="#vermessung"
							  class="relative flex h-12 items-center justify-center px-8 rounded-full border border-black/10 dark:border-white/20 bg-black/5 dark:bg-white/5 text-gray-900 dark:text-white font-bold transition hover:bg-black/10 dark:hover:bg-white/10 active:scale-95 sm:w-max"
							  aria-label="Unsere Leistungen im Bereich Vermessung und Planung ansehen"
							>
							  Unsere Leistungen
							</a>
							<a
							  href="#kontakt"
							  class="relative flex h-12 items-center justify-center px-8 rounded-full bg-almond text-eclipse font-bold transition hover:scale-105 active:scale-95 sm:w-max shadow-lg shadow-almond/20"
							  aria-label="Kontakt mit studio-os.de aufnehmen"
							>
							  Kontakt aufnehmen
							</a>
						</div>
					</div>

					<div class="w-full lg:w-[55%] hidden lg:flex flex-col items-center lg:items-end justify-center reveal relative z-10">
                        <!-- Logo (Large, Transparent) -->
                        <div class="relative lg:scale-110 lg:translate-x-12">
						    <Image src={osLogoLight} class="w-full max-w-[500px] h-auto opacity-[0.9] dark:hidden transition-all duration-700" id="hero-logo-light" alt="studio-os.de - Expert for Vectorworks, Archicad & BIM Planning" loading="eager" fetchpriority="high" />
						    <Image src={osLogoDark} class="w-full max-w-[500px] h-auto opacity-[0.9] hidden dark:block transition-all duration-700" id="hero-logo-dark" alt="studio-os.de - Expert for Vectorworks, Archicad & BIM Planning" loading="eager" fetchpriority="high" />
                        </div>
					</div>
				</div>
			</Container>

            <!-- Software Carousel (Outside container for true window centering) -->
            <div class="reveal w-full flex-[1.5] flex items-center justify-center">
                <SoftwareCarousel />
            </div>
		</div>

		<!-- Vermessung Section -->
		<div id="vermessung" class="relative min-h-dvh flex items-center bg-black/5 dark:bg-black/20 py-16 md:py-32 snap-start">
			<Container>
				<div class="zoom-content">
					<div class="md:w-2/3 lg:w-1/2 reveal">
						<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading">
							Gebäudevermessung & Digitales Aufmaß
						</h2>

						<p class="my-4 text-gray-700 dark:text-gray-200">
							Für Architekturbüros, Makler und Bauherren erfassen wir Bestandsobjekte mit modernster Technik zentimetergenau. Um Ihnen einen reibungslosen Start in die Planung zu garantieren, setzen wir auf drei Prinzipien:
						</p>
						<ul class="list-disc pl-6 mb-6 space-y-1 text-gray-700 dark:text-gray-200 max-w-xl">
							<li><strong>Verformungsgerechte Aufmaße:</strong> Eine hochpräzise und zuverlässige Erfassung der realen Bausubstanz.</li>
							<li><strong>Konsequent in 3D &amp; BIM:</strong> Jeder unserer Arbeitsschritte liefert Ihnen ein zukunftssicheres, intelligentes 3D-Modell.</li>
							<li><strong>Sofort startklar:</strong> Sie erhalten auf Wunsch native Daten für Ihr bevorzugtes CAD-System, die ohne weitere Anpassungen direkt von Ihnen genutzt werden können.</li>
						</ul>

						<h3 class="text-2xl font-bold text-gray-900 dark:text-white md:text-3xl font-heading mt-12 md:mt-[4.5rem]">
							Referenzprojekte
						</h3>
					</div>
					
					<!-- Interactive Portfolio Grid -->
					<div class="mt-8 md:mt-12 flex flex-col sm:flex-row flex-wrap gap-0 w-full portfolio-grid overflow-hidden rounded-3xl" data-any-expanded="false">
						{projects.map((project: any) => (
							<div 
                                class="group group/card relative flex-shrink-0 w-full sm:w-1/2 lg:w-1/3 overflow-hidden aspect-[4/3] data-[expanded=true]:aspect-[3/2] data-[expanded=true]:w-full reveal cursor-pointer portfolio-card" 
                                data-expanded="false"
                                role="button"
                                tabindex="0"
                                aria-label={`Projekt ${project.title} ansehen`}
                            >
                                <!-- Slideshow Container -->
                                <div class="absolute inset-0 w-full h-full slideshow-container bg-white">
                                    {project.images.map((img: any, idx: number) => (
                                        <div 
                                            class={`absolute inset-0 w-full h-full transition-all duration-700 ease-in-out slide ${idx === 0 ? 'opacity-100' : 'opacity-0'} ${img.isWide ? 'bg-black' : 'bg-white'}`}
                                            data-index={idx}
                                            data-wide={img.isWide}
                                        >
                                            {typeof img.src === 'string' ? (
                                                <img 
                                                    src={img.src} 
                                                    alt={`${project.title} - Professionelle Bestandsaufnahme und 3D-Modellierung`} 
                                                                                                        class={`transition-all duration-1000 ease-out group-hover/card:scale-110 ${img.isWide ? 'w-full h-full object-cover group-data-[expanded=true]:h-auto group-data-[expanded=true]:object-top group-data-[expanded=true]:[mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]' : 'w-full h-full object-cover group-data-[expanded=true]:block group-data-[expanded=true]:w-auto group-data-[expanded=true]:mx-auto group-data-[expanded=true]:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)]'}`}
                                                />
                                            ) : (
                                                <Image 
                                                    src={img.src} 
                                                    alt={`${project.title} - Digitale Bestandsaufnahme und BIM-Planung`} 
                                                                                                        class={`transition-all duration-1000 ease-out group-hover/card:scale-110 ${img.isWide ? 'w-full h-full object-cover group-data-[expanded=true]:h-auto group-data-[expanded=true]:object-top group-data-[expanded=true]:[mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]' : 'w-full h-full object-cover group-data-[expanded=true]:block group-data-[expanded=true]:w-auto group-data-[expanded=true]:mx-auto group-data-[expanded=true]:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)]'}`}
                                                />
                                            )}
                                        </div>
                                    ))}
                                </div>

                                <!-- Slideshow Controls -->
                                {project.images.length > 1 && (
                                    <>
                                        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-between px-6 opacity-0 transition-all duration-300 group-data-[expanded=true]:opacity-100 z-50 pointer-events-none">
                                            <button class="prev-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100" aria-label="Vorheriges Bild">
                                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
                                            </button>
                                            <button class="next-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100" aria-label="Nächstes Bild">
                                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                                            </button>
                                        </div>
                                        <button class="mobile-close-btn absolute top-6 right-6 z-[160] p-4 text-white bg-black/70 rounded-full opacity-0 transition-opacity duration-300 pointer-events-none group-data-[expanded=true]:opacity-100 group-data-[expanded=true]:pointer-events-auto md:hidden" aria-label="Schließen">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </>
                                )}

								<div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/95 via-black/75 to-transparent opacity-0 transition-opacity duration-700 delay-300 group-hover/card:opacity-100 flex flex-col justify-end p-8 pointer-events-none group-data-[expanded=true]:opacity-100 z-20 portfolio-info-fade">
									<h3 class="text-xl font-bold text-white font-heading transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">{project.title}</h3>
									<p class="mt-2 text-white/90 text-sm transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.description}
									</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</Container>
		</div>

		<!-- Visualisierung Section -->
		<div id="visualisierung" class="relative min-h-dvh flex items-center py-16 md:py-32 snap-start">
			<Container>
				<div class="zoom-content">
					<div class="md:w-2/3 lg:w-1/2 reveal">
						<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading">
							3D Visualisierung & Bildmontagen
						</h2>
						<p class="my-4 text-gray-700 dark:text-gray-200">
							Erwecken Sie Ihre Projekte schon vor dem ersten Spatenstich zum Leben! Mit hochwertigem Bildmaterial machen wir Ihre Planungen greifbar – eine ideale Unterstützung, um <strong>Kunden oder Investoren zu überzeugen</strong> und die Vermarktung zu beschleunigen.						</p>
					</div>
					
					<!-- Bild-Container -->
					<div class="mt-8 md:mt-12 flex flex-col md:flex-row gap-0 w-full portfolio-grid overflow-hidden rounded-3xl" data-any-expanded="false">
						{visualizations.map((project: any) => (
							<div 
                                class="group group/card relative flex-shrink-0 w-full md:w-1/2 overflow-hidden aspect-[4/3] data-[expanded=true]:aspect-[3/2] data-[expanded=true]:w-full reveal cursor-pointer portfolio-card" 
                                data-expanded="false"
                                role="button"
                                tabindex="0"
                                aria-label={`Visualisierung ${project.title} ansehen`}
                            >
								<!-- Slideshow Container -->
                                <div class="absolute inset-0 w-full h-full slideshow-container bg-black">
                                    {project.images.map((img: any, idx: number) => (
                                        <div 
                                            class={`absolute inset-0 w-full h-full transition-opacity duration-[1200ms] ease-in-out slide ${idx === 0 ? 'opacity-100' : 'opacity-0'} ${img.isWide ? 'bg-black' : 'bg-white'}`}
                                            data-index={idx}
                                        >
                                            {typeof img.src === 'string' ? (
                                                <img 
                                                    src={img.src} 
                                                    alt={`${project.title} - Professionelle Bestandsaufnahme und 3D-Modellierung`} 
                                                                                                        class={`transition-all duration-1000 ease-out group-hover/card:scale-110 ${img.isWide ? 'w-full h-full object-cover group-data-[expanded=true]:h-auto group-data-[expanded=true]:object-top group-data-[expanded=true]:[mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]' : 'w-full h-full object-cover group-data-[expanded=true]:block group-data-[expanded=true]:w-auto group-data-[expanded=true]:mx-auto group-data-[expanded=true]:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)]'}`}
                                                />
                                            ) : (
                                                <Image 
                                                    src={img.src} 
                                                    alt={`${project.title} - Digitale Bestandsaufnahme und BIM-Planung`} 
                                                                                                        class={`transition-all duration-1000 ease-out group-hover/card:scale-110 ${img.isWide ? 'w-full h-full object-cover group-data-[expanded=true]:h-auto group-data-[expanded=true]:object-top group-data-[expanded=true]:[mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_bottom,black_80%,transparent_100%)]' : 'w-full h-full object-cover group-data-[expanded=true]:block group-data-[expanded=true]:w-auto group-data-[expanded=true]:mx-auto group-data-[expanded=true]:[mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)] group-data-[expanded=true]:[-webkit-mask-image:linear-gradient(to_right,transparent_0%,black_5%,black_80%,transparent_100%)]'}`}
                                                />
                                            )}
                                        </div>
                                    ))}
                                </div>

                                <!-- Slideshow Controls -->
                                {project.images.length > 1 && (
                                    <>
                                        <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-between px-6 opacity-0 transition-all duration-300 group-data-[expanded=true]:opacity-100 z-50 pointer-events-none">
                                            <button class="prev-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100" aria-label="Vorheriges Bild">
                                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
                                            </button>
                                            <button class="next-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100" aria-label="Nächstes Bild">
                                                <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                                            </button>
                                        </div>
                                        <button class="mobile-close-btn absolute top-6 right-6 z-[160] p-4 text-white bg-black/70 rounded-full opacity-0 transition-opacity duration-300 pointer-events-none group-data-[expanded=true]:opacity-100 group-data-[expanded=true]:pointer-events-auto md:hidden" aria-label="Schließen">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12" /></svg>
                                        </button>
                                    </>
                                )}

								<div class="absolute inset-x-0 bottom-0 h-2/3 bg-gradient-to-t from-black/95 via-black/75 to-transparent opacity-0 transition-opacity duration-700 delay-300 group-hover/card:opacity-100 flex flex-col justify-end p-8 pointer-events-none group-data-[expanded=true]:opacity-100 z-20 portfolio-info-fade">
									<h3 class="text-xl font-bold text-white font-heading transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.title}
									</h3>
									<p class="mt-2 text-white opacity-90 transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.description}
									</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</Container>
		</div>

		<!-- CAD Section -->
		<div id="cad" class="relative min-h-dvh flex items-center bg-black/5 dark:bg-black/20 py-16 md:py-24 snap-start">
			<Container>
				<div class="zoom-content w-full">
					<div class="flex flex-col-reverse items-center gap-16 lg:flex-row reveal">
						<div class="lg:w-1/2">
							<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading mb-8">
								CAD Zeichnung & <br/> Planerstellung
							</h2>
							<p class="text-lg text-gray-700 dark:text-gray-200 mb-12">
								Da wir <strong>alle gängigen CAD-Programme beherrschen</strong>, zwingen wir Sie nicht in fremde Workflows, sondern integrieren uns nahtlos in Ihren. Sie erhalten von uns native Daten zur direkten Weiterbearbeitung – wobei wir speziell bei Bestandsplänen standardmäßig ein präzises 3D-Modell als Grundlage nutzen.							</p>
