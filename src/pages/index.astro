---
import Container from '../components/Container.astro';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';

import osLogoLight from '../assets/OS LOGO light.svg';
import osLogoDark from '../assets/OS LOGO dark.svg';

import v1_1 from '../assets/images/vermessung/Vermessung eines historischen Gebäudes in Bayreuth/VERMESSUNG_BEISPIEL 1.png';
import v1_2 from '../assets/images/vermessung/Vermessung eines historischen Gebäudes in Bayreuth/VERMESSUNG_BEISPIEL 1_BESTAND.jpg';
import v1_3 from '../assets/images/vermessung/Vermessung eines historischen Gebäudes in Bayreuth/VERMESSUNG_BEISPIEL 1_MODELL.png';
import v1_4 from '../assets/images/vermessung/Vermessung eines historischen Gebäudes in Bayreuth/VERMESSUNG_BEISPIEL 1_PLAENE.png';

import v2_1 from '../assets/images/vermessung/Vermessung eines Restaurantkomplexes in Nürnberg/VERMESSUNG_BEISPIEL 2.png';
import v2_2 from '../assets/images/vermessung/Vermessung eines Restaurantkomplexes in Nürnberg/VERMESSUNG_BEISPIEL 2 3D_DATEN_LUFTBILD.png';
import v2_3 from '../assets/images/vermessung/Vermessung eines Restaurantkomplexes in Nürnberg/VERMESSUNG_BEISPIEL 2 3D_MODELL.png';
import v2_4 from '../assets/images/vermessung/Vermessung eines Restaurantkomplexes in Nürnberg/VERMESSUNG_BEISPIEL 2 PLAENE.png';

import r1 from '../assets/images/renders/RENDER1.jpg';
import h1 from '../assets/images/renders/HOMESTAGING1.jpg';
import h2 from '../assets/images/renders/HOMESTAGING2.jpg';

import pinterestLight from '../assets/images/logos/pinterest light.svg';
import pinterestDark from '../assets/images/logos/pinterest dark.svg';
import instagramLight from '../assets/images/logos/instagram light.svg';
import instagramDark from '../assets/images/logos/instagram dark.svg';
import linkedinLight from '../assets/images/logos/linkedin light.svg';
import linkedinDark from '../assets/images/logos/linkedin dark.svg';

const projects = [
    {
        title: "Vermessung eines historischen Gebäudes in Bayreuth",
        description: "Detailliertes Aufmaß und digitale Bestandsaufnahme für komplexe Gebäudestrukturen. Klicken zum Erweitern.",
        images: [v1_1, v1_2, v1_3, v1_4]
    },
    {
        title: "Vermessung eines Restaurantkomplexes in Nürnberg",
        description: "Präzise Erfassung weitläufiger Gastronomieflächen zur Modernisierungsplanung. Klicken zum Erweitern.",
        images: [v2_1, v2_2, v2_3, v2_4]
    },
    {
        title: "Detailliertes Gebäudeaufmaß",
        description: "Umfassende digitale Dokumentation von Bestandsgebäuden als Planungsgrundlage. Klicken zum Erweitern.",
        images: [
            "https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80",
            "https://images.unsplash.com/photo-1503387762-592dea58ef21?auto=format&fit=crop&w=1200&q=80",
        ]
    }
];

const visualizations = [
    {
        title: "Professionelle Visualisierungen",
        description: "Ob aus bestehenden 2D-Plänen oder mit bereitgestellten Modellen, fotorealistisch oder stilisiert, Foto oder Video - wir setzen ihre Vorstellung um. Klicken zum Erweitern.",
        images: [r1]
    },
    {
        title: "Digitales Home-Staging",
        description: "Sie haben eine leere Wohnung- wir zeigen deren volles Potential. Klicken zum Erweitern.",
        images: [h1, h2]
    }
];
---

<Layout 
	title="studio-os.de | Präzise Vermessung, CAD-Planung & BIM-Modellierung"
	description="Experte für Gebäudevermessung, digitales Aufmaß und BIM-konforme 3D-Modelle. Wir bieten zentimetergenaue Bestandserfassung, CAD-Konstruktion und fotorealistische Visualisierung."
	keywords="Vermessung, Digitales Aufmaß, Bestandsaufnahme, Zentimetergenaue Bestandserfassung, Bestandspläne, Planzeichnung, 2D/3D Bestandsdokumentation, Grundrisse, Schnitte, Ansichten, CAD-Planung, Bauplanung, Computer-Aided Design, Bauzeichnung, CAD-Konstruktion, BIM, Building Information Modeling, BIM-Modellierung, Industry Foundation Classes, IFC, BIM-Konformität, Visualisierung, 3D-Design, 3D-Architekturvisualisierung, Rendering, Digital Twins, Räumliche Darstellung"
>
	<main class="overflow-hidden">
		<!-- Hero Section -->
		<div class="relative min-h-screen flex items-center transition-all duration-700 ease-in-out snap-start" id="home">
			<div aria-hidden="true" class="absolute inset-0 grid grid-cols-2 -space-x-52 opacity-50 dark:opacity-30">
				<div class="blur-[106px] h-64 bg-gradient-to-br from-matcha to-forest hidden dark:block dark:from-matcha/40"></div>
				<div class="blur-[106px] h-40 bg-gradient-to-r from-almond to-matcha hidden dark:block dark:to-forest/50"></div>
			</div>
			<Container>
				<div class="relative flex flex-col lg:flex-row items-center justify-between gap-12 lg:gap-24 transition-all duration-700 zoom-content" id="hero-content">
					<div class="w-full lg:w-[45%] text-left reveal z-10">
						<h1 class="text-gray-900 dark:text-white font-bold text-4xl md:text-5xl xl:text-6xl font-heading leading-tight transition-all duration-700" id="hero-title">
							Präzise Vermessung <br/> & 3D-Planung für <br/> Ihre Projekte
						</h1>
						<p class="mt-8 text-gray-700 dark:text-gray-300 text-lg lg:text-xl max-w-xl transition-all duration-700" id="hero-text">
							Von der digitalen Bestandsaufnahme bis zum BIM-konformen Modell – wir liefern die präzise Grundlage für Ihren Erfolg. Professionell, zuverlässig und zukunftsorientiert.
						</p>
						<div class="mt-12 flex flex-wrap gap-y-4 gap-x-6">
							<a
							  href="#vermessung"
							  class="relative flex h-12 items-center justify-center px-8 rounded-full border border-black/10 dark:border-white/20 bg-black/5 dark:bg-white/5 text-gray-900 dark:text-white font-bold transition hover:bg-black/10 dark:hover:bg-white/10 active:scale-95 sm:w-max"
							>
							  Unsere Leistungen
							</a>
							<a
							  href="#kontakt"
							  class="relative flex h-12 items-center justify-center px-8 rounded-full bg-almond text-eclipse font-bold transition hover:scale-105 active:scale-95 sm:w-max shadow-lg shadow-almond/20"
							>
							  Kontakt aufnehmen
							</a>
						</div>
					</div>

					<div class="w-full lg:w-[55%] flex flex-col items-center lg:items-end justify-center reveal relative">
                        <!-- Bokeh Effect -->
                        <div class="absolute inset-0 blur-[120px] bg-matcha/20 rounded-full scale-150 -z-10"></div>
                        
                        <!-- Logo (Large, Transparent) -->
                        <div class="relative lg:scale-150 lg:translate-x-12">
						    <Image src={osLogoLight} class="w-full max-w-[500px] h-auto opacity-[0.9] dark:hidden transition-all duration-700" id="hero-logo-light" alt="OS Logo light" loading="eager" fetchpriority="high" />
						    <Image src={osLogoDark} class="w-full max-w-[500px] h-auto opacity-[0.9] hidden dark:block transition-all duration-700" id="hero-logo-dark" alt="OS Logo dark" loading="eager" fetchpriority="high" />
                        </div>
                        
                        <!-- WebM Animation -->
                        <div class="absolute inset-0 flex items-center justify-right pointer-events-none lg:translate-x-30">
                            <video 
                                id="hero-video-light"
                                autoplay 
                                loop 
                                muted 
                                playsinline 
                                class="w-full h-full object-contain scale-[2.5] opacity-30 dark:hidden"
                            >
                                <source src={`${import.meta.env.BASE_URL}animation/animation light.webm`} type="video/webm" />
                            </video>
                            <video 
                                id="hero-video-dark"
                                autoplay 
                                loop 
                                muted 
                                playsinline 
                                class="w-full h-full object-contain scale-[2.5] opacity-30 hidden dark:block"
                            >
                                <source src={`${import.meta.env.BASE_URL}animation/animation dark.webm`} type="video/webm" />
                            </video>
                        </div>
					</div>
				</div>
			</Container>
		</div>

		<!-- Vermessung Section -->
		<div id="vermessung" class="relative min-h-screen flex items-center bg-black/5 dark:bg-black/20 py-24 snap-start">
			<Container>
				<div class="zoom-content">
					<div class="md:w-2/3 lg:w-1/2 reveal">
						<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading">
							Gebäudevermessung & Digitales Aufmaß
						</h2>

						<p class="my-8 text-gray-700 dark:text-gray-200">
							Für Architekten, Immobilienbesitzer und Bauherren erfassen wir Bestandsobjekte mit modernster Vermessungstechnik. Dabei garantieren wir für Ihre Planung:
						</p>

						<!-- HIER ANGEPASST: list-disc für Punkte, pl-6 für Einzug, space-y-4 für Abstand zwischen den Punkten, Textfarbe hinzugefügt -->
						<ul class="list-disc pl-6 mb-12 space-y-4 text-gray-700 dark:text-gray-200">
							<li>
								<strong>Verformungsgerechte Aufmaße:</strong> Professionelle und zentimetergenaue Bestandserfassung.
							</li>
							<li>
								<strong>Standardmäßig in 3D:</strong> Sie erhalten von uns immer ein vollständiges 3D BIM-Modell für die optimale Weiternutzung.
							</li>
							<li>
								<strong>Sofort startklar: Wir liefern die Daten auf Wunsch in allen gängigen CAD-Programmen. Starten Sie Ihre Planung direkt – ganz ohne zeitraubende Importe oder Format-Anpassungen.</strong>
							</li>
						</ul>

						<!-- HIER ANGEPASST: mt-12 oder pt-4 hinzugefügt, falls der mb-12 der Liste nicht ausreicht -->
						<h3 class="text-4xl font-bold text-gray-900 dark:text-white md:text-2xl font-heading">
							Referenzprojekte
						</h3>
					</div>
					
					<!-- Interactive Portfolio Grid -->
					<div class="mt-6 flex flex-col sm:flex-row gap-0 w-full portfolio-grid overflow-hidden rounded-3xl" data-any-expanded="false">
						{projects.map((project) => (
							<div class="group group/card relative flex-shrink-0 w-full sm:w-1/2 lg:w-1/3 overflow-hidden transition-all duration-700 ease-in-out h-[350px] hover:h-[450px] data-[expanded=true]:h-[600px] data-[expanded=true]:w-full data-[expanded=false]:data-[any-expanded=true]:w-0 data-[expanded=false]:data-[any-expanded=true]:h-0 data-[expanded=false]:data-[any-expanded=true]:opacity-0 reveal cursor-pointer portfolio-card" data-expanded="false">
                                <!-- Slideshow Container -->
                                <div class="absolute inset-0 w-full h-full slideshow-container">
                                    {project.images.map((img, idx) => (
                                        typeof img === 'string' ? (
                                            <img 
                                                src={img} 
                                                alt={`${project.title} - Bild ${idx + 1}`} 
                                                class={`absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-in-out group-hover/card:scale-105 slide ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
                                                data-index={idx}
                                            />
                                        ) : (
                                            <Image 
                                                src={img} 
                                                alt={`${project.title} - Bild ${idx + 1}`} 
                                                class={`absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-in-out group-hover/card:scale-105 slide ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
                                                data-index={idx}
                                            />
                                        )
                                    ))}
                                </div>

                                <!-- Slideshow Controls -->
                                {project.images.length > 1 && (
                                    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-between px-6 opacity-0 transition-all duration-300 group-data-[expanded=true]:opacity-100 z-50 pointer-events-none">
                                        <button class="prev-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
                                        </button>
                                        <button class="next-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                                        </button>
                                    </div>
                                )}

								<div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent opacity-0 transition-opacity duration-700 delay-300 group-hover/card:opacity-100 flex flex-col justify-end p-8 pointer-events-none group-data-[expanded=true]:opacity-100 z-20">
									<h3 class="text-xl font-bold text-white font-heading transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">{project.title}</h3>
									<p class="mt-2 text-white/90 text-sm transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.description}
									</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</Container>
		</div>

		<!-- Visualisierung Section -->
		<div id="visualisierung" class="relative min-h-screen flex items-center py-24 snap-start">
			<Container>
				<div class="zoom-content">
					<div class="md:w-2/3 lg:w-1/2 reveal">
						<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading">
							3D Visualisierung & Bildmontagen
						</h2>
						<p class="my-8 text-gray-700 dark:text-gray-200">
							Erwecken Sie Ihre Projekte schon vor dem ersten Spatenstich zum Leben. Mit hochwertigen 3D-Renderings und fotorealistischen Bildmontagen machen wir Ihre Planungen greifbar und unterstützen Sie bei der Vermarktung und Präsentation.
						</p>
					</div>
					
					<!-- Bild-Container -->
					<div class="mt-16 flex flex-col md:flex-row gap-0 w-full portfolio-grid overflow-hidden rounded-3xl" data-any-expanded="false">
						{visualizations.map((project) => (
							<div class="group group/card relative flex-shrink-0 w-full md:w-1/2 overflow-hidden transition-all duration-700 ease-in-out h-[350px] md:h-[450px] hover:h-[550px] data-[expanded=true]:h-[650px] data-[expanded=true]:w-full data-[expanded=false]:data-[any-expanded=true]:w-0 data-[expanded=false]:data-[any-expanded=true]:h-0 data-[expanded=false]:data-[any-expanded=true]:opacity-0 reveal cursor-pointer portfolio-card" data-expanded="false">
								<!-- Slideshow Container -->
                                <div class="absolute inset-0 w-full h-full slideshow-container">
                                    {project.images.map((img, idx) => (
                                        typeof img === 'string' ? (
                                            <img 
                                                src={img} 
                                                alt={`${project.title} - Bild ${idx + 1}`} 
                                                class={`absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-in-out group-hover/card:scale-105 slide ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
                                                data-index={idx}
                                            />
                                        ) : (
                                            <Image 
                                                src={img} 
                                                alt={`${project.title} - Bild ${idx + 1}`} 
                                                class={`absolute inset-0 h-full w-full object-cover transition-all duration-700 ease-in-out group-hover/card:scale-105 slide ${idx === 0 ? 'opacity-100' : 'opacity-0'}`}
                                                data-index={idx}
                                            />
                                        )
                                    ))}
                                </div>

                                <!-- Slideshow Controls -->
                                {project.images.length > 1 && (
                                    <div class="absolute inset-x-0 top-1/2 -translate-y-1/2 flex justify-between px-6 opacity-0 transition-all duration-300 group-data-[expanded=true]:opacity-100 z-50 pointer-events-none">
                                        <button class="prev-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7" /></svg>
                                        </button>
                                        <button class="next-slide pointer-events-auto p-4 rounded-full bg-black/70 text-white hover:bg-primary transition-all shadow-2xl scale-90 hover:scale-100">
                                            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7" /></svg>
                                        </button>
                                    </div>
                                )}

								<div class="absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/90 via-black/30 to-transparent opacity-0 transition-opacity duration-700 delay-300 group-hover/card:opacity-100 flex flex-col justify-end p-8 pointer-events-none group-data-[expanded=true]:opacity-100 z-20">
									<h3 class="text-xl font-bold text-white font-heading transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.title}
									</h3>
									<p class="mt-2 text-white opacity-90 transform translate-y-3 transition-transform duration-700 delay-300 group-hover/card:translate-y-0 group-data-[expanded=true]:translate-y-0">
										{project.description}
									</p>
								</div>
							</div>
						))}
					</div>
				</div>
			</Container>
		</div>

		<!-- CAD Section -->
		<div id="cad" class="relative min-h-screen flex items-center bg-black/5 dark:bg-black/20 py-32 md:py-48 snap-start">
			<Container>
				<div class="zoom-content w-full">
					<div class="flex flex-col-reverse items-center gap-16 lg:flex-row reveal">
						<div class="lg:w-1/2">
							<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading mb-8">
								CAD Zeichnung & <br/> Planerstellung
							</h2>
							<p class="text-lg text-gray-700 dark:text-gray-200 mb-12">
								Wir unterstützen Architekten und Planer bei der Ausarbeitung ihrer Projekte. Dabei sind wir nicht auf einen Arbeitsablauf beschränkt, sondern unterstützen alle gängigen CAD-Programme als 2D- oder 3D - volle Untertützung ohne Umwege.
							</p>
							<div class="grid sm:grid-cols-2 gap-6">
								<div class="p-8 rounded-[2rem] border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 transition hover:bg-black/10 dark:hover:bg-white/10">
									<h4 class="font-bold text-gray-900 dark:text-white text-xl mb-2 font-heading">2D Grundrisse</h4>
									<p class="text-gray-600 dark:text-gray-400">Präzise Dokumentation für Behörden und Ausbau.</p>
								</div>
								<div class="p-8 rounded-[2rem] border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 transition hover:bg-black/10 dark:hover:bg-white/10">
									<h4 class="font-bold text-gray-900 dark:text-white text-xl mb-2 font-heading">3D CAD Modelle</h4>
									<p class="text-gray-600 dark:text-gray-400">Dreidimensionale Erfassung der Bausubstanz.</p>
								</div>
							</div>
						</div>
						<div class="lg:w-1/2">
							<Image 
								src="https://images.unsplash.com/photo-1581092580497-e0d23cbdf1dc?auto=format&fit=crop&w=1200&q=80" 
								alt="CAD Zeichnung" 
								class="rounded-3xl shadow-2xl"
                                width={1200}
                                height={800}
							/>
						</div>
					</div>
				</div>
			</Container>
		</div>

		<!-- BIM Section -->
		<div id="bim" class="relative min-h-screen flex items-center py-32 md:py-48 snap-start">
			<Container>
				<div class="zoom-content w-full">
					<div class="flex flex-col items-center gap-16 lg:flex-row reveal">
						<div class="lg:w-1/2">
							<Image 
								src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1200&q=80" 
								alt="BIM Modell" 
								class="rounded-3xl shadow-2xl"
                                width={1200}
                                height={800}
							/>
						</div>
						<div class="lg:w-1/2">
							<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading mb-8">
								3D-Planung & <br/> BIM-konforme Modelle
							</h2>
							<p class="text-lg text-gray-700 dark:text-gray-200 mb-12">
								Setzen Sie auf die Zukunft des Bauens. Wir arbeiten nativ mit BIM-Modellen, die alle relevanten Informationen und Geometrien eines Gebäudes zentral bündeln und die Kollaboration aller Gewerke optimieren.
							</p>
							<div class="grid sm:grid-cols-2 gap-6">
								<div class="p-8 rounded-[2rem] border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 transition hover:bg-black/10 dark:hover:bg-white/10">
									<h4 class="font-bold text-gray-900 dark:text-white text-xl mb-2 font-heading">Modellierung aus 2D-Plänen</h4>
									<p class="text-gray-600 dark:text-gray-400">Bereiten Sie ihre Pläne auf die Zukunft vor - und überlassen Sie uns die Informationsverarbeitung.</p>
								</div>
								<div class="p-8 rounded-[2rem] border border-black/10 dark:border-white/10 bg-black/5 dark:bg-white/5 transition hover:bg-black/10 dark:hover:bg-white/10">
									<h4 class="font-bold text-gray-900 dark:text-white text-xl mb-2 font-heading">Geometrie als umfassendes IFC-Modell</h4>
									<p class="text-gray-600 dark:text-gray-400">BIM-Modelle als Grundlage für Fachplaner und Planerstellung.</p>
								</div>
							</div>
						</div>
					</div>
				</div>
			</Container>
		</div>

		<!-- Kontakt Section -->
		<div id="kontakt" class="relative min-h-screen flex items-center bg-black/5 dark:bg-black/40 py-32 md:py-48 snap-start">
			<Container>
				<div class="zoom-content w-full flex flex-col items-center">
					<div class="w-full rounded-[3rem] bg-white dark:bg-[#060D0D] p-12 md:p-24 border border-black/10 dark:border-white/10 overflow-hidden relative reveal shadow-2xl">
						<div class="absolute top-0 right-0 -translate-y-12 translate-x-12 blur-[200px] opacity-40">
							<div class="h-[40rem] w-[40rem] rounded-full bg-matcha"></div>
						</div>
						<div class="relative flex flex-col items-center justify-between gap-16 lg:flex-row">
							<div class="lg:w-2/3 text-center lg:text-left">
								<h2 class="text-4xl font-bold text-gray-900 dark:text-white md:text-5xl font-heading mb-8">
									Bereit für Ihr nächstes Projekt?
								</h2>
								<p class="text-gray-700 dark:text-gray-300 text-xl leading-relaxed max-w-2xl">
									Ob präzise Gebäudevermessung, detaillierte CAD-Planung oder hochwertige Visualisierung – wir beraten Sie gerne umfassend zu allen unseren Leistungen und entwickeln die optimale Lösung für Ihr individuelles Vorhaben.
								</p>
							</div>
							<div class="flex flex-col items-center gap-10 w-full lg:w-auto">
