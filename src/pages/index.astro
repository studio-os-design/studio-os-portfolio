<style>
	.reveal {
		opacity: 0;
		transform: translateY(2rem);
		transition: all 0.8s ease-out;
	}
	.reveal.active {
		opacity: 1;
		transform: translateY(0);
	}

    .zoom-content {
        transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 1.2s cubic-bezier(0.2, 0.8, 0.2, 1);
        width: 100%;
        opacity: 1;
        transform: scale(1);
    }

    @media (prefers-reduced-motion: no-preference) {
        .zoom-content {
            opacity: 0;
            transform: scale(0.92);
        }
        
        /* Disable scale on mobile to allow fixed positioning for slideshow */
        @media (max-width: 640px) {
            .zoom-content {
                transform: none !important;
                opacity: 1 !important;
            }
        }

        .snap-start.active-section .zoom-content {
            transform: scale(1);
            opacity: 1;
        }
    }

    .portfolio-card {
        transition: all 1.2s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.5s ease-in-out, scale 0.8s ease-in-out !important;
    }

    .portfolio-card[data-expanded="true"] {
        z-index: 50;
        transition: all 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    /* Problem 3: Mobile full-screen */
    @media (max-width: 640px) {
        .portfolio-card[data-expanded="true"] {
            position: fixed !important;
            inset: 0 !important;
            height: 100dvh !important;
            width: 100vw !important;
            z-index: 100 !important;
            border-radius: 0 !important;
            aspect-ratio: auto !important;
            transition: opacity 0.5s ease-in-out !important;
            animation: fade-in 0.5s ease-in-out forwards;
            background: black;
        }

        @keyframes fade-in {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .portfolio-card[data-expanded="true"] img {
            width: 100vw !important;
            height: 100dvh !important;
            object-fit: contain !important;
            scale: 1 !important;
            transition: none !important;
        }
        
        .portfolio-card[data-expanded="true"] .slideshow-container {
            height: 100dvh !important;
            background: black;
        }

        .portfolio-card[data-expanded="true"] .portfolio-info-fade {
            opacity: 1 !important;
            animation: none !important;
            pointer-events: auto;
            transform: none !important;
            display: flex !important;
            z-index: 150 !important;
            background: linear-gradient(to top, rgba(0,0,0,0.25), transparent) !important;
        }

        /* Wide image specific: remove background and fade */
        .portfolio-card[data-expanded="true"] .slide[data-wide="true"] {
            background: transparent !important;
        }
        .portfolio-card[data-expanded="true"] .slide[data-wide="true"] ~ .portfolio-info-fade {
            background: transparent !important;
        }

        .portfolio-card[data-expanded="true"] .mobile-close-btn {
            opacity: 1 !important;
            pointer-events: auto !important;
            display: block !important;
            z-index: 200 !important;
            scale: 0.7; /* Smaller button */
        }

        .portfolio-card[data-expanded="true"] .prev-slide,
        .portfolio-card[data-expanded="true"] .next-slide {
            scale: 0.6 !important; /* Smaller buttons */
        }
    }

    .portfolio-card[data-expanded="false"][data-any-expanded="true"] {
        opacity: 0 !important;
        scale: 0.3 !important;
        width: 0 !important;
        height: 0 !important;
        pointer-events: none;
        transition: opacity 0.4s ease-in, scale 0.7s ease-in, width 1.2s cubic-bezier(0.4, 0, 0.2, 1), height 1.2s cubic-bezier(0.4, 0, 0.2, 1) !important;
    }

    .portfolio-info-fade {
        transition: opacity 0.7s ease-in-out;
    }

    /* Only show hover info when nothing is expanded */
    .portfolio-grid[data-any-expanded="false"] .portfolio-card:hover .portfolio-info-fade {
        opacity: 1;
    }

    .portfolio-card[data-expanded="true"] .portfolio-info-fade {
        opacity: 1 !important;
        animation: none !important;
    }

    /* Desktop only: remove hover zoom when expanded */
    @media (min-width: 641px) {
        .portfolio-card[data-expanded="true"] img {
            scale: 1 !important;
        }
    }

    /* Keep text visible for 2 seconds after closing */
    .portfolio-card[data-recent-close="true"] .portfolio-info-fade {
        opacity: 1 !important;
        transition: opacity 0.8s ease-in-out 2s !important;
    }

    /* Hide text completely when any card is expanded, unless it's the expanded one */
    .portfolio-grid[data-any-expanded="true"] .portfolio-card[data-expanded="false"] .portfolio-info-fade {
        opacity: 0 !important;
        animation: none !important;
    }

    /* Prevent hover flicker during transition */
    .portfolio-card[data-transitioning="true"] .portfolio-info-fade {
        opacity: 0 !important;
        animation: none !important;
    }

    @keyframes fade-out-info {
        from { opacity: 1; }
        to { opacity: 0; }
    }
</style>

<script>
	const observerOptions = {
		root: null,
		rootMargin: '0px',
		threshold: 0.1
	};

    const sectionOptions = {
        root: null,
        rootMargin: '0px',
        threshold: 0.1
    };

	const observer = new IntersectionObserver((entries) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
				entry.target.classList.add('active');
			}
		});
	}, observerOptions);

    const sectionObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('active-section');
            } else {
                entry.target.classList.remove('active-section');
            }
        });
    }, sectionOptions);

	window.addEventListener('DOMContentLoaded', () => {
		const revealElements = document.querySelectorAll('.reveal');
		revealElements.forEach(el => observer.observe(el));

        const sections = document.querySelectorAll('.snap-start');
        sections.forEach(section => sectionObserver.observe(section));

		// Portfolio & Slideshow Logic
		const portfolioCards = document.querySelectorAll('.portfolio-card');

        portfolioCards.forEach(card => {
            const slides = card.querySelectorAll('.slide');
            const prevBtn = card.querySelector('.prev-slide') as HTMLElement;
            const nextBtn = card.querySelector('.next-slide') as HTMLElement;
            const mobileCloseBtn = card.querySelector('.mobile-close-btn') as HTMLElement;
            let currentSlide = 0;

            // Swipe state
            let touchStartX = 0;
            let touchStartY = 0;
            let touchStartTime = 0;

            function showSlide(index: number) {
                if (index === currentSlide) return;
                
                const currentImg = slides[currentSlide] as HTMLElement;
                const nextImg = slides[index] as HTMLElement;

                // Move next image to top and hide it initially
                nextImg.style.transition = 'none';
                nextImg.style.opacity = '0';
                nextImg.style.zIndex = '30';
                
                // Ensure current image is below and visible
                currentImg.style.zIndex = '20';
                currentImg.style.opacity = '1';

                // Force reflow
                nextImg.offsetHeight;

                // Start fade in
                nextImg.style.transition = 'opacity 1200ms ease-in-out';
                nextImg.style.opacity = '1';

                // Cleanup other slides
                slides.forEach((slide, i) => {
                    if (i !== index && i !== currentSlide) {
                        (slide as HTMLElement).style.opacity = '0';
                        (slide as HTMLElement).style.zIndex = '0';
                    }
                });

                currentSlide = index;
            }

            function updateSlide(index: number) {
                showSlide(index);
            }

            prevBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                let next = currentSlide - 1;
                if (next < 0) next = slides.length - 1;
                updateSlide(next);
            });

            nextBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                let next = currentSlide + 1;
                if (next >= slides.length) next = 0;
                updateSlide(next);
            });

            mobileCloseBtn?.addEventListener('click', (e) => {
                e.stopPropagation();
                (card as HTMLElement).click(); // Trigger minimize
            });

            // Mobile Gestures
            card.addEventListener('touchstart', (e) => {
                if (card.getAttribute('data-expanded') !== 'true') return;
                if ((e as TouchEvent).touches.length > 1) return;
                
                touchStartX = (e as TouchEvent).touches[0].clientX;
                touchStartY = (e as TouchEvent).touches[0].clientY;
                touchStartTime = Date.now();
            }, { passive: true });

            card.addEventListener('touchend', (e) => {
                if (card.getAttribute('data-expanded') !== 'true') return;
                if ((e as TouchEvent).touches.length > 0) return;
                
                const touchEndX = (e as TouchEvent).changedTouches[0].clientX;
                const touchEndY = (e as TouchEvent).changedTouches[0].clientY;
                const diffX = touchEndX - touchStartX;
                const diffY = touchEndY - touchStartY;
                const diffTime = Date.now() - touchStartTime;

                if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY) && diffTime < 300) {
                    if (diffX > 0) {
                        let next = currentSlide - 1;
                        if (next < 0) next = slides.length - 1;
                        updateSlide(next);
                    } else {
                        let next = currentSlide + 1;
                        if (next >= slides.length) next = 0;
                        updateSlide(next);
                    }
                }
            }, { passive: true });

            card.addEventListener('keydown', (e) => {
                if ((e as KeyboardEvent).key === 'Enter' || (e as KeyboardEvent).key === ' ') {
                    e.preventDefault();
                    (card as HTMLElement).click();
                }
            });

            card.addEventListener('click', () => {
                const isExpanded = card.getAttribute('data-expanded') === 'true';
                const grid = card.closest('.portfolio-grid');
                const otherCards = grid?.querySelectorAll('.portfolio-card');
                const isMobile = window.innerWidth < 640;
                
                if (!isExpanded) {
                    card.setAttribute('data-expanded', 'true');
                    
                    if (isMobile) {
                        document.body.style.overflow = 'hidden';
                    } else {
                        grid?.setAttribute('data-any-expanded', 'true');
                        otherCards?.forEach(c => {
                            if (c !== card) {
                                c.setAttribute('data-expanded', 'false');
                                c.setAttribute('data-any-expanded', 'true');
                            }
                        });
                        
                        setTimeout(() => {
                            card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 600);
                    }
                } else {
                    card.setAttribute('data-expanded', 'false');
                    card.setAttribute('data-recent-close', 'true');
                    document.body.style.overflow = '';
                    
                    if (!isMobile) {
                        card.setAttribute('data-transitioning', 'true');
                        grid?.setAttribute('data-any-expanded', 'false');
                        otherCards?.forEach(c => {
                            c.setAttribute('data-any-expanded', 'false');
                        });
                    }

                    // Reset smoothly
                    if (currentSlide !== 0) {
                        showSlide(0);
                    }
                    
                    setTimeout(() => {
                        currentSlide = 0;
                        if (!isMobile) card.removeAttribute('data-transitioning');
                        
                        slides.forEach((slide, i) => {
                            const s = slide as HTMLElement;
                            s.style.opacity = i === 0 ? '1' : '0';
                            s.style.zIndex = i === 0 ? '20' : '0';
                            s.style.transition = 'none';
                            const img = s.querySelector('img');
                            if (img) img.style.transform = '';
                        });
                        
                        const info = card.querySelector('.portfolio-info-fade') as HTMLElement;
                        if (info) {
                            info.style.animation = '';
                            info.style.opacity = '';
                            info.style.transition = '';
                        }

                        if (prevBtn && nextBtn) {
                            prevBtn.style.opacity = '';
                            nextBtn.style.opacity = '';
                            prevBtn.style.display = '';
                            nextBtn.style.display = '';
                            prevBtn.style.transition = '';
                            nextBtn.style.transition = '';
                        }

                        // Remove recent-close after its transition is done (2s delay + 0.8s duration)
                        setTimeout(() => {
                            card.removeAttribute('data-recent-close');
                        }, 3000);
                    }, isMobile ? 500 : 1200);
                }
            });
        });
	});
</script>
